rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidSymptomEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'symptomText', 'primaryAilmentName', 'healingAffirmation']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.symptomText is string && data.symptomText.size() <= 1000 &&
        data.primaryAilmentName is string && data.primaryAilmentName.size() <= 256 &&
        data.healingAffirmation is string && data.healingAffirmation.size() <= 1000 &&
        (!('primaryAilmentId' in data) || (data.primaryAilmentId is string && data.primaryAilmentId.size() <= 128)) &&
        (!('dominantChakra' in data) || (data.dominantChakra is string && data.dominantChakra.size() <= 64)) &&
        (!('bodySide' in data) || (data.bodySide is string && data.bodySide.size() <= 32)) &&
        (!('metaphysicalMeaning' in data) || (data.metaphysicalMeaning is string && data.metaphysicalMeaning.size() <= 2000)) &&
        (!('emotionalRoot' in data) || (data.emotionalRoot is string && data.emotionalRoot.size() <= 2000)) &&
        (!('reflectionNotes' in data) || (data.reflectionNotes is string && data.reflectionNotes.size() <= 4000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && incoming().userId == existing().userId;
      allow delete: if false;

      match /symptomEntries/{entryId} {
        allow get: if isSignedIn() && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(entryId) && isValidSymptomEntry(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(entryId) && isValidSymptomEntry(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
